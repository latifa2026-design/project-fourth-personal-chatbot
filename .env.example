# ============================================================
#  Chatbot configuration — copy this file to .env and fill in.
#  .env is git-ignored, so your API key never gets committed.
# ============================================================

# Your Groq API key (required)
GROQ_API_KEY=

# The Groq model to use (optional)
# openai/gpt-oss-20b is fast, capable, and available on the free tier.
GROQ_MODEL=openai/gpt-oss-20b

# The name the chatbot uses to introduce itself (optional)
PERSON_NAME=Your Assistant